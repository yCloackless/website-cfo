{
  "manifest_version": 3,
  "name": "CFO CBMERJ — Cronômetro & Nivelamento",
  "version": "1.0.0",
  "description": "Cronômetro tático de estudos e registro de questões com nivelamento (meta de 80%) para o concurso CFO CBMERJ.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CFO CBMERJ — Painel Tático",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ]
}
