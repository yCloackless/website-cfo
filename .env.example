# ==============================================================================
# CFO CBMERJ - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA insira senhas, chaves reais ou secrets de produção neste arquivo.
# Copie para .env e preencha com credenciais geradas de forma segura.
# ==============================================================================

# AMBIENTE E REDE
NODE_ENV="production"
PORT=3000
APP_URL="https://seu-dominio-ou-render.onrender.com"
TRUSTED_PROXIES=""
TRUST_CLOUDFLARE_HEADERS="false"

# IA / GOOGLE GEMINI (OPCIONAL - fallback local disponível)
GEMINI_API_KEY="AIzaSy_EXEMPLO_FICTICIO_GEMINI_KEY"
ENABLE_EXTERNAL_AI="false" # habilite conscientemente: dados enviados ao provedor externo

# GOOGLE OAUTH 2.0 (INTEGRAÇÃO AGENDA OFFLINE RESILIENTE)
GOOGLE_CLIENT_ID="1234567890-exemplo.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-ExemploSecretGoogleOAuth"
CALENDAR_EMAIL="admin@seu-dominio.com"

# NOTION DATABASE (CRONOGRAMA E CICLO DE REVISÕES)
NOTION_API_KEY="secret_exemplo_notion_key"
NOTION_DATABASE_ID="exemplo_database_id_32_chars"

# AUTENTICAÇÃO E CONTROLE DE ACESSO (DEFESA EM PROFUNDIDADE)
ADMIN_USER="admin"
ADMIN_USER_EMAIL="admin@seu-dominio.com"
ADMIN_PASSWORD="sua_senha_mestra_super_segura_aqui"
CADET_USER="cadete"
CADET_USER_EMAIL="cadete@cbmerj.com"
CADET_PASSWORD="senha_acesso_alunos_cadetes_aqui"
ALLOWED_EMAILS="admin@seu-dominio.com"
# VITE_ALLOWED_GOOGLE_EMAILS: Opcional. ATENÇÃO: variáveis VITE_ são compiladas no bundle público do navegador.
# A autorização segura é validada no backend via ALLOWED_EMAILS.
ALLOWED_IPS="127.0.0.1,::1"

# SEGURANÇA CRIPTOGRÁFICA (SESSÕES ASSINADAS HMAC-SHA256)
SESSION_SECRET="d08f3b2591a78345fa6338b1f8ef440c9f04944d18388fb45a27faecae059b02" # 64 hex chars
DATA_ENCRYPTION_KEY="gere_uma_chave_aleatoria_diferente_da_chave_de_sessao"
BACKUP_ENCRYPTION_KEY="gere_outra_chave_aleatoria_para_os_backups"

# CLOUDFLARE TURNSTILE (PROTEÇÃO ANTI-BOT SERVER-SIDE)
TURNSTILE_SITE_KEY="0x4AAAAAA_SITE_KEY_PUBLICO"
TURNSTILE_SECRET_KEY="0x4AAAAAA_SECRET_KEY_PRIVADO_BACKEND"

# SISTEMA PROFISSIONAL DE BACKUP (ARMAZENAMENTO S3 / CLOUDFLARE R2 OFF-SITE)
BACKUP_S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
BACKUP_S3_BUCKET="cfo-cbmerj-backups"
BACKUP_S3_ACCESS_KEY="exemplo_r2_access_key"
BACKUP_S3_SECRET_KEY="exemplo_r2_secret_key"
BACKUP_S3_REGION="auto"

# E-MAIL TRANSACIONAL (RESEND — https://resend.com)
# Free tier: 3.000 e-mails/mês, 100/dia. Sem domínio próprio em dev.
# Obter em: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Endereço remetente — deve ser verificado no painel do Resend
# Em dev sem domínio próprio, use: onboarding@resend.dev
EMAIL_FROM="noreply@seudominio.com"
