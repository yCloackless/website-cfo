# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# GOOGLE OAUTH 2.0 (CALENDAR PERSISTENTE - OFFLINE ACCESS)
# Client ID e Client Secret para manter a Google Agenda conectada sem desconectar a cada 1 hora
GOOGLE_CLIENT_ID="1077493396610-ah620bmq8nqgn7m68nom30g8a5rbakuq.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="SEU_CLIENT_SECRET_AQUI"

# TERMINAL DE ACESSO RESTRITO (2FA TOTP)
ADMIN_USER="admin"
ADMIN_PASSWORD="sua_senha_segura_aqui"
TOTP_SECRET="SEU_SEGREDO_BASE32_AQUI"
SESSION_SECRET="SEU_SESSION_SECRET_HEX_AQUI"
